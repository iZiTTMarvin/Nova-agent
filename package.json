{
  "name": "nova-agent",
  "version": "0.1.2",
  "description": "长会话与多 Agent 编排的本地桌面 Agent — 缓存感知上下文、XForge 工作流、会话树与记忆检索",
  "author": "许皓辰",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "node scripts/verify-native-bootstrap.mjs",
    "dev": "npm run sync:icon && electron-vite dev",
    "build": "electron-vite build",
    "build:headless": "vite build --config vite.headless.config.ts && vite build --config vite.headless-worker.config.ts",
    "nova:headless": "node out/headless/nova-headless.cjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live-cache": "vitest run --config vitest.live-cache.config.ts",
    "test:perf": "node scripts/run-perf-gate.mjs",
    "test:headless-smoke": "npm run build:headless && node scripts/harness_eval/smoke_headless.mjs",
    "test:headless-code-graph": "node scripts/run-headless-code-graph-smoke.mjs",
    "code-graph:compare-ab": "node scripts/harness_eval/compare_code_graph_ab.mjs",
    "test:memory-integration": "node scripts/run-memory-integration-test.mjs",
    "test:e2e:install": "npm --prefix tests/e2e install --no-package-lock --ignore-scripts --no-audit --no-fund",
    "test:e2e:typecheck": "tsc --noEmit -p tests/e2e/tsconfig.json",
    "test:e2e:smoke": "npm run build && npm --prefix tests/e2e run test:smoke",
    "test:e2e": "npm run build && npm --prefix tests/e2e run test:main",
    "test:e2e:code-index-weight": "npm run build && npm --prefix tests/e2e run test:weight",
    "test:e2e:fault": "npm run build && npm --prefix tests/e2e run test:fault",
    "test:e2e:stress": "npm run build && npm --prefix tests/e2e run test:stress",
    "test:e2e:packaged": "npm run build && electron-builder --config electron-builder.yml --win --dir && npm --prefix tests/e2e run test:packaged",
    "validate:skills": "node scripts/validate-skill-frontmatter.mjs",
    "sync:icon": "node scripts/sync-build-icon.mjs",
    "astryx:theme": "astryx theme build src/renderer/styles/astryx-parchment-theme.ts -o src/renderer/styles/astryx-parchment.css",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "rebuild:native:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:native:node": "node scripts/rebuild-better-sqlite3-node.mjs",
    "spike:memory-electron": "electron scripts/spike/memory-electron.mjs",
    "pack": "npm run sync:icon && electron-builder --config electron-builder.yml --win nsis",
    "pack:spike": "electron-builder --config electron-builder.spike.yml --win portable",
    "pack:spike:verify": "node scripts/spike/run-pack-spike-exe.mjs",
    "dist": "npm run build && npm run pack && node scripts/verify-pack-icons.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.2.0",
    "@astryxdesign/theme-neutral": "^0.2.0",
    "@jitl/quickjs-singlefile-cjs-release-sync": "^0.32.0",
    "@pierre/diffs": "1.2.12",
    "@tanstack/react-virtual": "^3.14.5",
    "@vscode/ripgrep": "^1.18.0",
    "better-sqlite3": "^11.9.1",
    "chokidar": "3.6.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.40.0",
    "gray-matter": "^4.0.3",
    "iconv-lite": "^0.7.2",
    "quickjs-emscripten-core": "^0.32.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.5",
    "web-tree-sitter": "0.26.12",
    "yauzl": "^3.4.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.2.0",
    "@electron/rebuild": "^3.7.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yauzl": "^3.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "autoprefixer": "^10.5.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "gpt-tokenizer": "^3.4.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
